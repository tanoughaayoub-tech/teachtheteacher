const COLORS = { sk: '#00e5ff', nv: '#a78bfa', pk: '#f472b6' };

function drawWave(canvasId, type) {
  const canvas = document.getElementById(canvasId);
  if (!canvas) return;
  const dpr = window.devicePixelRatio || 1;
  canvas.width = canvas.offsetWidth * dpr;
  canvas.height = 140 * dpr;
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr, dpr);
  const W = canvas.offsetWidth, H = 140;
  ctx.clearRect(0, 0, W, H);

  const col = COLORS[type];
  ctx.strokeStyle = col;
  ctx.lineWidth = 2.5;
  ctx.shadowColor = col;
  ctx.shadowBlur = 8;
  ctx.beginPath();

  const baseline = H * 0.75;

  if (type === 'pk') {
    // Pacemaker: slow prepotential, slow upstroke, slow repolarization — repeated twice
    const cycleW = W / 2.2;
    for (let c = 0; c < 2; c++) {
      const ox = c * (W / 2.1) + 10;
      const pts = [
        [0, baseline],
        [cycleW*0.45, baseline - 28],  // slow rise (If)
        [cycleW*0.58, baseline - 38],  // T-Ca2+ boost
        [cycleW*0.68, H*0.18],          // L-Ca2+ upstroke (peak)
        [cycleW*0.82, baseline - 10],   // repolarization
        [cycleW, baseline],
      ];
      for (let i = 0; i < pts.length; i++) {
        const x = ox + pts[i][0], y = pts[i][1];
        i === 0 && c === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
      }
    }
  } else {
    // Skeletal & nervous: fast spike
    const rest = baseline;
    const pts = [
      [0, rest], [W*0.12, rest],
      [W*0.20, rest - 10],
      [W*0.26, H*0.12],           // peak
      [W*0.34, rest + (type==='nv'?12:2)],
      [W*0.44, rest],
      [W, rest],
    ];
    pts.forEach(([x,y],i) => i===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y));
  }

  ctx.stroke();
  ctx.shadowBlur = 0;

  // Axis labels
  ctx.fillStyle = 'rgba(136,146,170,0.7)';
  ctx.font = '10px Space Mono, monospace';
  ctx.fillText('+', 4, 16);
  ctx.fillText('−', 4, H - 8);
  ctx.fillText('time →', W - 55, H - 6);
}

function buildPhases(type) {
  const grid = document.getElementById('phases-' + type);
  if (!grid) return;
  PHASES[type].forEach((p, i) => {
    const card = document.createElement('div');
    card.className = 'phase-card';
    card.style.setProperty('--accent', COLORS[type]);
    card.innerHTML = `<div class="phase-num">${p.num}</div><div class="phase-name">${p.name}</div><div class="phase-mv">${p.mv}</div><div class="phase-detail">${p.detail}</div>`;
    card.addEventListener('click', () => {
      const was = card.classList.contains('selected');
      grid.querySelectorAll('.phase-card').forEach(c => c.classList.remove('selected'));
      if (!was) card.classList.add('selected');
    });
    grid.appendChild(card);
  });
}

