// ── ECG ANIMATION ──
let ecgRaf;
function animateECG() {
  const line = document.getElementById('ecg-line');
  const totalW = 500;
  let progress = 0;
  const speed = 2.5;
  const pts = buildECGPoints(totalW);

  function frame() {
    progress = Math.min(progress + speed, totalW);
    const visible = pts.filter(p => p[0] <= progress);
    line.setAttribute('points', visible.map(p => p.join(',')).join(' '));
    if (progress < totalW) {
      ecgRaf = requestAnimationFrame(frame);
    } else {
      // loop after pause
      setTimeout(() => {
        progress = 0;
        line.setAttribute('points', '');
        ecgRaf = requestAnimationFrame(frame);
      }, 1800);
    }
  }
  ecgRaf = requestAnimationFrame(frame);
}

function buildECGPoints(W) {
  const mid = 40;
  const pts = [];
  // flatline section
  for (let x = 0; x <= 80; x += 4) pts.push([x, mid]);
  // P wave
  for (let i = 0; i <= 20; i++) {
    const x = 80 + i * 1.5;
    const y = mid - 8 * Math.sin(Math.PI * i / 20);
    pts.push([x, y]);
  }
  // PR segment
  for (let x = 110; x <= 130; x += 4) pts.push([x, mid]);
  // QRS complex
  pts.push([130, mid]);
  pts.push([133, mid + 5]);   // Q
  pts.push([136, mid - 32]);  // R peak
  pts.push([139, mid + 10]);  // S
  pts.push([142, mid]);
  // ST segment
  for (let x = 142; x <= 165; x += 4) pts.push([x, mid]);
  // T wave
  for (let i = 0; i <= 30; i++) {
    const x = 165 + i * 1.5;
    const y = mid - 12 * Math.sin(Math.PI * i / 30);
    pts.push([x, y]);
  }
  // flatline to end
  for (let x = 210; x <= W; x += 4) pts.push([x, mid]);
  return pts;
}

// ── CONFETTI ──
let confettiRaf, confettiPieces = [];
const CONFETTI_COLORS = ['#00e5ff','#a78bfa','#f472b6','#34d399','#fbbf24','#fff'];

function launchConfetti() {
  const canvas = document.getElementById('gift-canvas');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  confettiPieces = Array.from({length: 120}, () => ({
    x: Math.random() * canvas.width,
    y: Math.random() * -canvas.height * 0.5,
    w: 6 + Math.random() * 8,
    h: 3 + Math.random() * 4,
    color: CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)],
    vx: (Math.random() - 0.5) * 2.5,
    vy: 1.5 + Math.random() * 3,
    rot: Math.random() * 360,
    rotV: (Math.random() - 0.5) * 6,
    opacity: 0.7 + Math.random() * 0.3,
  }));

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    confettiPieces.forEach(p => {
      p.x += p.vx;
      p.y += p.vy;
      p.rot += p.rotV;
      if (p.y > canvas.height + 20) {
        p.y = -20;
        p.x = Math.random() * canvas.width;
      }
      ctx.save();
      ctx.globalAlpha = p.opacity;
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI / 180);
      ctx.fillStyle = p.color;
      ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      ctx.restore();
    });
    confettiRaf = requestAnimationFrame(draw);
  }
  confettiRaf = requestAnimationFrame(draw);
}

function stopConfetti() {
  cancelAnimationFrame(confettiRaf);
  cancelAnimationFrame(ecgRaf);
  const canvas = document.getElementById('gift-canvas');
  canvas.getContext('2d').clearRect(0, 0, canvas.width, canvas.height);
}

window.addEventListener('resize', () => {
  ['sk','nv','pk'].forEach(k => {
    const c = document.getElementById('wave-'+k);
    if (c && c.offsetWidth > 0) drawWave('wave-'+k, k);
  });
});
</script>
