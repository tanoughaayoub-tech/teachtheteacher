const PHASES = {
  sk: [
    { num:'Phase 1', name:'Resting potential', mv:'−90 mV', detail:'K⁺ leak channels and the Na⁺/K⁺-ATPase pump maintain −90 mV. More negative than neurons due to higher K⁺ conductance.' },
    { num:'Phase 2', name:'NMJ → Depolarization', mv:'−90 → +40 mV', detail:'ACh released into synaptic cleft → binds nicotinic receptors on motor end plate → generates EPP → threshold reached → fast Na⁺ channels open. AP travels along sarcolemma and down T-tubules → Ca²⁺ released from sarcoplasmic reticulum → contraction.' },
    { num:'Phase 3', name:'Repolarization', mv:'+40 → −90 mV', detail:'Na⁺ channels inactivate. Delayed K⁺ channels open → K⁺ efflux drives membrane back toward rest. Ca²⁺ pumped back into SR.' },
